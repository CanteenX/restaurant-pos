#!/bin/sh
set -e
ENVF=/etc/nventra-pos/nventra-pos.env
if [ "$1" = configure ]; then
  # First install: create the settings file from the shipped example. It is never overwritten or removed by apt.
  if [ ! -f "$ENVF" ]; then
    install -d -m 0755 /etc/nventra-pos
    install -m 0600 /usr/share/nventra-pos/nventra-pos.env.example "$ENVF"
  fi
  # Replace every @SECRET@ with a fresh random value (only a new file has any).
  if grep -q '@SECRET@' "$ENVF" 2>/dev/null; then
    tmp=$(mktemp)
    while IFS= read -r line; do
      case "$line" in
        *@SECRET@*) s=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'); printf '%s\n' "${line%%@SECRET@*}$s${line#*@SECRET@}" ;;
        *) printf '%s\n' "$line" ;;
      esac
    done < "$ENVF" > "$tmp"
    cat "$tmp" > "$ENVF"; rm -f "$tmp"
  fi
  chmod 0600 "$ENVF"
  # Warn early about a missing Docker or a busy port (never fails the install).
  sh /usr/lib/nventra-pos/preflight.sh "$(sed -n 's/^HOST_PORT=//p' "$ENVF" | head -n1)" || true
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable nventra-pos.service >/dev/null 2>&1 || true
  if [ -d /run/systemd/system ]; then
    # Starting pulls the images; do not fail the install if Docker is not ready.
    systemctl restart nventra-pos.service >/dev/null 2>&1 || \
      echo "nventra-pos: could not start yet; check Docker, then run: sudo systemctl start nventra-pos" >&2
  fi
  echo "Nventra POS is installed. Open http://localhost:1995 (first start pulls the images and can take a few minutes)."
fi
exit 0
