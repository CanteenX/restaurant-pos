[Unit]
Description=Nventra POS (Docker Compose)
Documentation=https://github.com/CanteenX/restaurant-pos
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
ExecStart=/usr/bin/docker compose --project-name nventra-pos --env-file /etc/nventra-pos/nventra-pos.env -f /usr/lib/nventra-pos/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --project-name nventra-pos --env-file /etc/nventra-pos/nventra-pos.env -f /usr/lib/nventra-pos/docker-compose.yml down

[Install]
WantedBy=multi-user.target
