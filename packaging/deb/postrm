#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "nventra-pos: your data stays in Docker volumes (nventra-pos_pg_data, nventra-pos_uploads_data, nventra-pos_state) and your settings and generated passwords in /etc/nventra-pos/nventra-pos.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name nventra-pos down -v ; sudo rm -rf /etc/nventra-pos" >&2
fi
exit 0
