# Copy to .env before running `docker compose up`. Compose reads .env from
# this directory automatically — never commit the real .env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
# Shared secret between the backend and the updater container (which holds the
# Docker socket). Required; use a long random value: openssl rand -hex 32
# (./install.sh generates one). The updater refuses short or placeholder values.
UPDATER_TOKEN=
FRONTEND_ORIGIN=http://localhost:1995
HOST_PORT=1995

# Leave unset/false for the default plain-HTTP setup (LAN IP, localhost, a
# VPS reached over http://). Only set to "true" once this app is actually
# served over HTTPS (a reverse proxy, a Cloudflare Tunnel, etc.) — the
# session cookie is marked Secure when this is true, and browsers silently
# refuse to store a Secure cookie on a plain http:// origin, which locks
# every user out with "Unauthorized" even though login appears to succeed.
COOKIE_SECURE=false

# Idle sign-out in minutes (default 60). Any activity in the second half of
# the window renews the session, so busy terminals stay signed in while an
# idle or lost device drops out. "Log out of all devices" (and an admin
# password or 2FA reset) ends every session of that user immediately.
# SESSION_IDLE_MINUTES=60
# The web app also signs a browser out after that many minutes without a
# tap or key press (warning first). The Kitchen Display is exempt. Set to
# false to turn the browser-side idle sign-out off on every screen.
# SESSION_IDLE_SIGNOUT=true
# Absolute cap in hours (default 12): even a constantly active tab must
# sign in again after this long.
# SESSION_MAX_HOURS=12

# Optional: makes THIS server a sync hub that Windows/desktop installs can
# two-way sync with (Settings → Server Sync on the other PC). Use a long random
# value (openssl rand -hex 24) and leave unset on installs that are not the hub.
# SYNC_API_KEY=

# --- Email (docs/email.md) ---------------------------------------------------
# Leave both unset to keep email off. Gmail example (use an app password):
# SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# SMTP_FROM="My Cafe <you@gmail.com>"
# Public base URL used in marketing unsubscribe links
# PUBLIC_URL=https://pos.mycafe.com

# --- Website integration (docs/website-integration.md) ---------------------
# Served over HTTPS through a Cloudflare Tunnel, e.g. https://api.example.com:
#   COOKIE_SECURE=true
#   FRONTEND_ORIGIN=https://api.example.com   # comma-separate to allow several exact origins
# Proxy hops in front of the WEB container (a number 0-5, never "true"). Default 0 = use
# the connecting address. Set 1 only when ALL traffic comes through the tunnel or one
# reverse proxy (see README "Client IPs"). Leave TRUST_PROXY (backend) at its default 1.
# WEB_TRUST_PROXY=0
# Per-API-key rate limits (requests/minute) for the Integration API.
# INTEGRATION_WRITE_LIMIT_PER_MIN=30
# INTEGRATION_READ_LIMIT_PER_MIN=300
# The tunnel token (only if cloudflared runs as a compose service). Never commit it.
# CLOUDFLARE_TUNNEL_TOKEN=
# The website's own backend env (NOT this file; server-side only):
#   ORDERRESTRO_URL=https://api.example.com
#   ORDERRESTRO_API_KEY=ordr_ext_...
#   ORDER_COOKIE_SECRET=<openssl rand -hex 32>

# --- In-app updates (Settings > Updates) -------------------------------------
# GitHub repo whose tags are the releases this install updates to.
# UPDATE_REPO=CanteenX/restaurant-pos
# GHCR backend image checked for a published tag (defaults to the rebranded name).
# UPDATE_IMAGE_REPO=ghcr.io/canteenx/nventra-pos-backend
# Only for PRIVATE images: a GitHub token with read:packages, used for the
# manifest check and the updater's docker pull. Never commit it; never logged.
# GHCR_TOKEN=
