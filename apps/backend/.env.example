DATABASE_URL="postgresql://nventra:nventra_dev_pw@localhost:5432/nventra_pos"
JWT_SECRET="change-me-in-production"
# Sign-out after this many idle minutes (sliding; activity renews it).
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
PORT=4001
CORS_ORIGIN="http://localhost:1995"

# Sign-up (POST /auth/register) is first-run setup only: once the server has a
# restaurant it is closed. Set true ONLY if you deliberately host several
# restaurants and accept that each new owner gets instance-level permissions
# (backup, update, sync) - see SECURITY.md.
# ALLOW_PUBLIC_SIGNUP=false

# Encrypts third-party integration credentials at rest (AES-256-GCM). 16+ chars.
# If unset it is derived from JWT_SECRET, so rotating JWT_SECRET would orphan
# saved credentials - set a dedicated key in production and back it up.
# INTEGRATION_SECRET_KEY=

# Outgoing email (docs/email.md). Leave unset to keep email off.
# Gmail example: URL-encode the @ in the username as %40, use an app password.
# SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# SMTP_FROM="My Cafe <you@gmail.com>"
# Public base URL used in marketing unsubscribe links
# PUBLIC_URL=https://pos.mycafe.com

# Backup restore: runs as the limited role "nventra_restore", created at
# startup and derived from DATABASE_URL (nothing to set by default). Override
# only with another LIMITED role:
# DATABASE_RESTORE_URL="postgresql://restore_role:password@localhost:5432/nventra_pos"
# DANGEROUS, leave unset: allow restoring as an over-privileged role
# (superuser, CREATE on the schema, table owner, TRIGGER). See docs/BACKUPS.md.
# NVENTRA_ALLOW_UNSAFE_SUPERUSER_RESTORE=1
# Cap on the uncompressed size of a restored uploads archive (default 4 GiB).
# NVENTRA_RESTORE_MAX_UNCOMPRESSED_BYTES=4294967296
